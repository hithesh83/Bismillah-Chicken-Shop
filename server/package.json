{
  "name": "bismillah-server",
  "version": "0.3.0",
  "description": "Express backend for Bismillah Chicken Shop Management System",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:status": "node src/db/migrate.js --status",
    "db:verify": "node src/db/verify.js",
    "admin:provision": "node scripts/provision-admin.js",
    "test": "node --test tests/schema.test.js tests/auth.test.js tests/products.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3"
  }
}
