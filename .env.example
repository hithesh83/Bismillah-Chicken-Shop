# ─────────────────────────────────────────────────────────────
# Bismillah Chicken Shop – Environment Variable Template
# ─────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file → .env  (never commit .env to Git)
#   2. Replace every placeholder value with your real credentials
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database (Supabase PostgreSQL) – Phase 2 ──────────────────
# DB_HOST=your-supabase-host.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-database-password

# ── Supabase API – Phase 2 ────────────────────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
