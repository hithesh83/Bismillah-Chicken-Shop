# ─────────────────────────────────────────────────────────────
# Bismillah Chicken Shop – Environment Variable Template
# ─────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file → .env  (never commit .env to Git)
#   2. Replace every placeholder with your real credentials
#   3. Never put real credentials in this file
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database – Migrations (Direct Connection, port 5432 ONLY) ─
# Used by: npm run db:migrate, npm run db:verify
# Must NOT be the Transaction Pooler URL (port 6543)
DATABASE_URL_DIRECT=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# ── Database – Application Queries ────────────────────────────
# Used by: the running Express server
# May be the Transaction Pooler (port 6543) or direct
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# ── Database – Tests (MUST be a separate test project/schema) ─
# Used by: npm test
# Must NOT equal DATABASE_URL or DATABASE_URL_DIRECT
DATABASE_URL_TEST=postgresql://postgres:your-test-password@db.your-test-project-ref.supabase.co:5432/postgres

# ── Supabase API (reserved for Phase 3 browser client) ────────
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Authentication ─────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 bytes. Keep secret — anyone with this value can forge tokens.
JWT_SECRET=your-jwt-secret-minimum-32-random-bytes

# Frontend origin allowed to send cookies cross-origin
CLIENT_ORIGIN=http://localhost:5173
